# Copy to .agents/dorcheco/.env (or use root .env) and fill in the keys you use (KEY=VALUE, no quotes).
# Never commit .env to git.

# Git commit identity and GitHub CLI token
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=

# Model provider keys (fill only the harnesses you plan to run)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_KEY=

# Default Ollama Cloud model for Pi inside dorcheco when OLLAMA_API_KEY is set
PI_OLLAMA_MODEL=glm-5.3-flash:cloud

# Optional: custom Pydantic-AI harness model (e.g., ollama:glm-5.3-flash:cloud, openai:gpt-4o-mini, or test)
ECON_AGENT_MODEL=test

# Optional: Langfuse tracing (leave blank to keep telemetry off)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
