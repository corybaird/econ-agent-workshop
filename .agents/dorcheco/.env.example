# Copy to .agents/dorcheco/.env and fill in the keys you use (KEY=VALUE, no quotes).
# Never commit .env to git.

# Git commit identity and GitHub CLI token
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=

# Model provider keys (fill only the harnesses you plan to run)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_KEY=

# Optional: custom Pydantic-AI harness model (e.g., openai:gpt-4o-mini or test)
ECON_AGENT_MODEL=

# Optional: Langfuse tracing (leave blank to keep telemetry off)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
