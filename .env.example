# Copy to .env (or .agents/dorcheco/.env) and fill in the keys you use (KEY=VALUE, no quotes).
# Never commit .env to git.

# Ollama Cloud (used by both econ-agent-harness and Pi inside dorcheco)
OLLAMA_API_KEY=
# Default Pi model when OLLAMA_API_KEY is set inside dorcheco (e.g., glm-5.3-flash:cloud or beam)
PI_OLLAMA_MODEL=glm-5.3-flash:cloud

# Custom Pydantic-AI harness model (loaded automatically by econ_agent_harness.agent):
#   Leave blank to auto-use Ollama Cloud (ollama:<PI_OLLAMA_MODEL>) when OLLAMA_API_KEY is set,
#   or set explicitly: test | ollama:glm-5.3-flash:cloud | ollama:beam | anthropic:claude-sonnet-4-5
ECON_AGENT_MODEL=

# Optional provider keys (fill only the harnesses you plan to run)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Git commit identity and GitHub CLI token (used inside dorcheco)
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=

# Optional Langfuse tracing (leave blank to keep telemetry off)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
